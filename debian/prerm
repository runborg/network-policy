#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop services if running
        if [ -d /run/systemd/system ]; then
            systemctl stop network-policy-healthcheck.service >/dev/null 2>&1 || true
            systemctl stop network-policy-init.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
