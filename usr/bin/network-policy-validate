#!/usr/bin/env python3
"""
network-policy-validate - Configuration validator

Validates network policy TOML configuration without applying it.
"""

import sys
import argparse

# Add library to path
sys.path.insert(0, '/usr/lib/network-policy')

from config import load_config, ValidationError

DEFAULT_CONFIG = "/data/network-policy.toml"


def main():
    """Main validation function."""
    parser = argparse.ArgumentParser(
        description="Network Policy Configuration Validator"
    )
    parser.add_argument(
        "config",
        nargs="?",
        default=DEFAULT_CONFIG,
        help=f"Configuration file to validate (default: {DEFAULT_CONFIG})"
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Show detailed validation information"
    )
    
    args = parser.parse_args()
    
    try:
        print(f"Validating configuration: {args.config}")
        print("=" * 60)
        
        # Load and validate configuration
        config = load_config(args.config)
        
        # Show summary if verbose
        if args.verbose:
            print("\nConfiguration Summary:")
            print("-" * 60)
            
            if "system" in config:
                print("\n✓ System configuration found")
                if "hostname" in config["system"]:
                    print(f"  Hostname: {config['system']['hostname']}")
            
            if "users" in config:
                print(f"\n✓ User accounts: {len(config['users'])}")
                for username in config["users"].keys():
                    print(f"  - {username}")
            
            # Count interfaces
            interface_count = 0
            for iface_type in ["ethernet", "wifi", "lte", "wireguard"]:
                if iface_type in config:
                    count = len(config[iface_type])
                    interface_count += count
                    print(f"\n✓ {iface_type.capitalize()} interfaces: {count}")
                    for iface_name in config[iface_type].keys():
                        enabled = config[iface_type][iface_name].get("enabled", True)
                        status = "enabled" if enabled else "disabled"
                        print(f"  - {iface_name} ({status})")
            
            if "firewall" in config:
                fw = config["firewall"]
                print(f"\n✓ Firewall: {'enabled' if fw.get('enabled', True) else 'disabled'}")
                
                if "address_groups" in fw:
                    print(f"  Address groups: {len(fw['address_groups'])}")
                
                if "services" in fw:
                    print(f"  Services: {len(fw['services'])}")
                
                if "input_rules" in fw:
                    print(f"  Input rules: {len(fw['input_rules'])}")
            
            if "healthcheck" in config:
                hc = config["healthcheck"]
                print("\n✓ Health monitoring configured")
                print(f"  Interval: {hc.get('interval_sec', 30)}s")
                print(f"  Timeout: {hc.get('timeout_sec', 5)}s")
            
            if "routes" in config:
                print(f"\n✓ Static routes: {len(config['routes'])}")
        
        print("\n" + "=" * 60)
        print("✓ Configuration is valid!")
        print("=" * 60)
        
        return 0
        
    except ValidationError as e:
        print("\n" + "=" * 60)
        print("✗ Configuration validation FAILED!")
        print("=" * 60)
        print(f"\nError: {e}\n")
        return 1
    except FileNotFoundError as e:
        print(f"\n✗ Error: Configuration file not found: {args.config}\n")
        return 1
    except Exception as e:
        print(f"\n✗ Error: {e}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
