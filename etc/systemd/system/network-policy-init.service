[Unit]
Description=Network Policy Initialization
Documentation=man:network-policy(8)
After=network-pre.target NetworkManager.service
Before=network.target
Wants=network-pre.target NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/network-policy-init -c /data/network-policy.toml
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
