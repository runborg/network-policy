[Unit]
Description=Network Policy Health Monitoring Daemon
Documentation=man:network-policy(8)
After=network-policy-init.service network-online.target
Wants=network-online.target
Requires=network-policy-init.service

[Service]
Type=simple
ExecStart=/usr/bin/network-policy-healthcheck -c /data/network-policy.toml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run /var/log

[Install]
WantedBy=multi-user.target
